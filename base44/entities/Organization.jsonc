{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "contact_email": {
      "type": "string"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "telegram": {
          "type": "string"
        },
        "vk": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        }
      }
    },
    "owner_email": {
      "type": "string",
      "description": "Email \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430/\u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044f"
    }
  },
  "required": [
    "name"
  ]
}