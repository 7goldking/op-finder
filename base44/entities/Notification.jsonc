{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044f"
    },
    "type": {
      "type": "string",
      "enum": [
        "application_accepted",
        "application_rejected",
        "application_in_review"
      ]
    },
    "event_title": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_email",
    "type"
  ]
}