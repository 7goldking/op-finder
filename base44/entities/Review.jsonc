{
  "name": "Review",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "text": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "org_reply": {
      "type": "string",
      "description": "\u041e\u0442\u0432\u0435\u0442 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "org_reply_author": {
      "type": "string"
    },
    "org_reply_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "rating"
  ]
}