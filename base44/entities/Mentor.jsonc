{
  "name": "Mentor",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email \u043c\u0435\u043d\u0442\u043e\u0440\u0430 (\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u043f\u0440\u043e\u0444\u0438\u043b\u044f)"
    },
    "name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043c\u0435\u043d\u0442\u043e\u0440\u0430"
    },
    "avatar_url": {
      "type": "string"
    },
    "headline": {
      "type": "string",
      "description": "\u041a\u043e\u0440\u043e\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 / \u0434\u043e\u043b\u0436\u043d\u043e\u0441\u0442\u044c"
    },
    "bio": {
      "type": "string",
      "description": "\u041e \u043c\u0435\u043d\u0442\u043e\u0440\u0435"
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041e\u0431\u043b\u0430\u0441\u0442\u0438 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u0438\u0437\u044b"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "years_experience": {
      "type": "number"
    },
    "price_per_session": {
      "type": "number",
      "description": "0 = \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e"
    },
    "session_format": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "hybrid"
      ],
      "default": "online"
    },
    "linkedin_url": {
      "type": "string"
    },
    "telegram": {
      "type": "string"
    },
    "social_links": {
      "type": "array",
      "description": "\u0421\u043e\u0446\u0441\u0435\u0442\u0438 \u0438 \u0441\u0441\u044b\u043b\u043a\u0438",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "accepting_requests": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "headline"
  ]
}