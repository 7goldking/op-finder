{
  "name": "GroupChat",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0433\u0440\u0443\u043f\u043f\u044b"
    },
    "created_by": {
      "type": "string",
      "description": "Email \u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044f"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0421\u043f\u0438\u0441\u043e\u043a emails \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL \u0430\u0432\u0430\u0442\u0430\u0440\u0430 \u0433\u0440\u0443\u043f\u043f\u044b"
    }
  },
  "required": [
    "name",
    "created_by",
    "members"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.members": "{{user.email}}"
    },
    "update": {
      "data.members": "{{user.email}}"
    },
    "delete": {
      "data.created_by": "{{user.email}}"
    }
  }
}