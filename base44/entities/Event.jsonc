{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u043e\u0431\u044b\u0442\u0438\u044f"
    },
    "organization_name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "organization_id": {
      "type": "string",
      "description": "ID \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438"
    },
    "organization_verified": {
      "type": "boolean",
      "default": false
    },
    "cover_url": {
      "type": "string",
      "description": "URL \u043e\u0431\u043b\u043e\u0436\u043a\u0438"
    },
    "description": {
      "type": "string",
      "description": "\u041f\u043e\u043b\u043d\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 (rich text / markdown)"
    },
    "short_description": {
      "type": "string",
      "description": "\u041a\u0440\u0430\u0442\u043a\u043e\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438"
    },
    "category": {
      "type": "string",
      "enum": [
        "hackathon",
        "olympiad",
        "volunteering",
        "internship",
        "grant",
        "summer_school",
        "mentorship",
        "forum",
        "exchange",
        "competition",
        "mun",
        "custom"
      ]
    },
    "category_custom": {
      "type": "string",
      "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f (\u0435\u0441\u043b\u0438 category = 'custom')"
    },
    "format": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "hybrid"
      ]
    },
    "city": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en",
        "multi"
      ]
    },
    "level": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "school",
          "bachelor",
          "master",
          "any"
        ]
      }
    },
    "min_age": {
      "type": "number"
    },
    "max_age": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "string",
      "description": "\u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c"
    },
    "application_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "event_start": {
      "type": "string",
      "format": "date-time"
    },
    "event_end": {
      "type": "string",
      "format": "date-time"
    },
    "result_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "closed",
        "archived"
      ],
      "default": "published"
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "applications_count": {
      "type": "number",
      "default": 0
    },
    "form_fields": {
      "type": "array",
      "description": "\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0440\u0443\u0435\u043c\u044b\u0435 \u043f\u043e\u043b\u044f \u0430\u043d\u043a\u0435\u0442\u044b",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "select",
              "multiselect",
              "file",
              "date"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "category",
    "format"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "account_type": "organization"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "data.organization_id": "{{user.organization_id}}",
          "user_condition": {
            "account_type": "organization"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.organization_id}}",
          "user_condition": {
            "account_type": "organization"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.organization_id}}",
          "user_condition": {
            "account_type": "organization"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}