{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_a": {
      "type": "string",
      "description": "\u041c\u0435\u043d\u044c\u0448\u0438\u0439 email (\u043b\u0435\u043a\u0441\u0438\u043a\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438) \u2014 \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430"
    },
    "participant_b": {
      "type": "string",
      "description": "\u0411\u043e\u043b\u044c\u0448\u0438\u0439 email \u2014 \u0434\u043b\u044f \u043f\u043e\u0438\u0441\u043a\u0430"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041e\u0431\u0430 email (\u0434\u043b\u044f \u0443\u0434\u043e\u0431\u0441\u0442\u0432\u0430)"
    },
    "participant_names": {
      "type": "object",
      "description": "Map email -> name"
    },
    "participant_avatars": {
      "type": "object",
      "description": "Map email -> avatar_url"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sender_email": {
      "type": "string"
    },
    "unread_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "participant_a",
    "participant_b"
  ]
}