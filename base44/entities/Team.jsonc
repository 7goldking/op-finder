{
  "name": "Team",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u044b"
    },
    "description": {
      "type": "string",
      "description": "\u041e \u043a\u043e\u043c\u0430\u043d\u0434\u0435 / \u0447\u0442\u043e \u0438\u0449\u0435\u043c"
    },
    "captain_email": {
      "type": "string"
    },
    "captain_name": {
      "type": "string"
    },
    "looking_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u041a\u043e\u0433\u043e \u0438\u0449\u0435\u043c (\u0440\u043e\u043b\u0438/\u043d\u0430\u0432\u044b\u043a\u0438)"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "max_size": {
      "type": "number",
      "default": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "full",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "event_id",
    "name",
    "captain_email"
  ]
}