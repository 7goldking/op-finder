{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "follower_email": {
      "type": "string",
      "description": "Email \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0430"
    },
    "following_email": {
      "type": "string",
      "description": "Email \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430/\u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0438, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043d\u044b"
    },
    "following_type": {
      "type": "string",
      "enum": [
        "user",
        "organization"
      ],
      "default": "user"
    }
  },
  "required": [
    "follower_email",
    "following_email"
  ],
  "rls": {
    "create": {
      "data.follower_email": "{{user.email}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "data.follower_email": "{{user.email}}"
    }
  }
}